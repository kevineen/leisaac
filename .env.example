# =============================================================================
# LeIsaac / LeRobot マシン固有設定テンプレート
# 使い方:
#   1. このファイルをコピーして .env.local を作る（git には入れない）
#        cp .env.example .env.local
#   2. パス・役割・GPU をこのマシン向けに編集
#   3. シェルで読み込む:
#        source scripts/env/load_env.sh
#      または Python 側（leisaac.utils.machine_config）が自動読込
# =============================================================================

# --- マシン識別 --------------------------------------------------------------
# 表示用の名前（任意）
MACHINE_NAME=training-pc

# 役割: training | teleop | deploy
#   training … 学習（この PC の R9700 では ROCm 学習のみ。Isaac は NVIDIA 機 or 差し替え後）
#   teleop   … 実機テレオペ（例: Raspberry Pi）
#   deploy   … 推論のみ
MACHINE_ROLE=training

# OS 種別: linux | windows | raspberrypi
MACHINE_OS=linux

# --- GPU --------------------------------------------------------------------
# auto  … nvidia-smi / rocm-smi / lspci から自動判定
# nvidia | amd | none … 手動固定
GPU_VENDOR=auto

# Isaac Sim / Isaac Lab を使うか: auto | true | false
#   auto … NVIDIA のときだけ true（AMD / ラズパイは false）
ISAAC_ENABLED=auto

# --- データ保存先（大容量は別ドライブを指す） --------------------------------
# この1つを変えれば、下の派生パスもまとめて切り替わる
# Linux 例:  /mnt/shared_hdd/robot
# Windows例: D:/robot  または  E:/robot_data
# ラズパイ例: /mnt/usb_ssd/robot  または  /home/pi/robot_data
ROBOT_DATA_ROOT=/mnt/shared_hdd/robot

# 個別上書きが必要なときだけ設定（空なら ROBOT_DATA_ROOT から自動生成）
# LEISAAC_ASSETS_ROOT=
# ROBOT_DATASETS_HDF5=
# ROBOT_DATASETS_LEROBOT=
# ROBOT_MODELS_CHECKPOINTS=
# ROBOT_MODELS_DEPLOY=
# ROBOT_LOGS=
# ROBOT_EXPORTS=

# LeRobot / Hugging Face のキャッシュ・データセットホーム（任意）
# 学習 PC では共有 HDD 推奨:
# HF_LEROBOT_HOME=/mnt/shared_hdd/robot/datasets/lerobot
# LEROBOT_HOME=
# HF_HOME=

# --- 関連リポジトリ ----------------------------------------------------------
LEROBOT_REPO=/home/kevin/robot/lerobot
